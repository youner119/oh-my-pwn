node_modules/
dist/
*.log
.DS_Store
references/

# pwno-mcp container mount source (D-1). Staged challenge files (binary/libc/ld)
# accumulate here at runtime via omp_stage_challenge. The folder itself is kept
# committed via .gitkeep so the docker mount target always exists.
workspace/*
!workspace/.gitkeep

# Personal tool configs (not useful for other machines)
.claude/
.codex

# Manual test fixtures (local CTF binaries + run artifacts)
test_challenge/

# .omc/ — whitelist only the real OmP spec/state/research artifacts;
# exclude ephemeral OMC tooling byproducts (test sessions, hud state, ralph
# state, delegation audit logs, etc.) that leak in from other OMC usage.
.omc/*
!.omc/research/
!.omc/specs/
!.omc/state/
!.omc/decisions.md
.omc/state/*
!.omc/state/current-task.md
!.omc/state/prev-task.md
.omx/
