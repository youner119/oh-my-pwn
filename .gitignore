node_modules/
dist/
*.log
.DS_Store
references/

# Global SQLite DB at repo root (Phase 1 db-mcp spec).
# 정상 DB 위치는 challenge 별 `<challenge>/.omp/state.db` — repo 루트의
# `state.db` 는 OMP_DB_PATH 미설정 시 생기는 런타임 잔재라 추적 안 함.
# WAL 모드 사이드카 (.db-wal / .db-shm) 도 checkpoint 마다 변경되는
# 임시 파일이라 commit noise — 같이 추적 안 함.
state.db
state.db-wal
state.db-shm

# pwno-mcp container mount source (D-1). Staged challenge files (binary/libc/ld)
# accumulate here at runtime via omp_stage_challenge. The folder itself is kept
# committed via .gitkeep so the docker mount target always exists.
workspace/*
!workspace/.gitkeep

# Personal tool configs (not useful for other machines)
.claude/
.codex

# Manual test fixtures (local CTF binaries + run artifacts)
test_challenge/

# Local development artifacts — kept locally only, never tracked in the
# public repo. Full history + these files live in the private oh-my-pwn-dev
# backup. No whitelist: everything under .omc/ stays untracked.
.omc/
.omp
.omx/
CLAUDE.md
research.md
scripts/sync-release.sh

# Test fixture leak guards.
#
# - .test-*/ — OmO claude-tasks / session-storage / task-create / task-get /
#   task-update test 가 cwd 에 상대경로로 만드는 fixture 폴더. cleanup
#   누락. OmP 가 root 에서 `bun test` 를 잘못 돌릴 때만 생기지만 (정상
#   경로는 `cd src && bun test`) untracked 노이즈 방지.
# - src/.omc/ — OmP test 가 cwd=src 에서 돌 때 `.omc/state/last-tool-error.json`
#   를 거기 만드는 부산물. 진짜 OmC artifacts 는 root 의 `.omc/` 만 정본.
.test-*/
src/.omc/

# knowledge/sources/ — raw original dumps (블로그 export / PDF / writeup binary
# 등 비정형 raw 자료). 사이즈 크니까 git 추적 안 함. 머신마다 별도 저장
# (cloud / 외장 / 다른 dir) — 부재해도 agent reference 가 graceful skip.
# 단 정책 안내 README 한 장만 whitelist.
knowledge/sources/*
!knowledge/sources/README.md
